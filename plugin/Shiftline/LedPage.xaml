<UserControl x:Class="Shiftline.Plugin.LedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shiftline.Plugin"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <local:IconTitle IconKey="Layout" Text="LED layout" />
                        <StackPanel Orientation="Horizontal" Margin="28,6,0,0">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" ToolTip="LEDs on the left side | top LEDs | LEDs on the right side">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} | {1} | {0}">
                                        <Binding Path="SideLeds" />
                                        <Binding Path="CentreLeds" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="LayoutToggle" Style="{StaticResource GlassToggleButton}" VerticalAlignment="Center" Content="Change" />
                </Grid>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=LayoutToggle, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource CardHint}" Text="Set this to the LEDs of your device: LEDs per side plus the top LEDs make up the whole strip. The first LED is the outer end of the left side." />
                    <StackPanel Margin="0,14,0,0">
                        <local:SlSlider Title="LEDs per side (outer groups)" Minimum="1" Maximum="8" Value="{Binding SideLeds, Mode=TwoWay}" Margin="0,4" />
                        <local:SlSlider Title="Top LEDs" Minimum="2" Maximum="32" Value="{Binding CentreLeds, Mode=TwoWay}" Margin="0,4" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="TrafficLightH" Text="LED function" />
                <TextBlock Style="{StaticResource CardHint}" Text="What the LEDs do. This decides which of the settings below apply. Effects, brightness, idle and the fuel colours are always available." />
                <StackPanel Margin="0,14,0,0">
                <WrapPanel>
                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="ledfunction" Width="150" Content="RPM + Brake" Tag="RPM" Click="Function_Click" IsChecked="{Binding LedFunction, Converter={StaticResource StrEq}, ConverterParameter=rpmBrake}" />
                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="ledfunction" Width="150" Content="RPM" Tag="RPM" Click="Function_Click" IsChecked="{Binding LedFunction, Converter={StaticResource StrEq}, ConverterParameter=rpmOnly}" />
                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="ledfunction" Width="150" Content="Brake" Tag="Brake" Click="Function_Click" IsChecked="{Binding LedFunction, Converter={StaticResource StrEq}, ConverterParameter=brakeOnly}" />
                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="ledfunction" Width="150" Content="Pedals" Tag="Pedals" Click="Function_Click" IsChecked="{Binding LedFunction, Converter={StaticResource StrEq}, ConverterParameter=brakeThrottle}" />
                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="ledfunction" Width="150" Content="Fuel" Tag="Fuel" Click="Function_Click" IsChecked="{Binding LedFunction, Converter={StaticResource StrEq}, ConverterParameter=fuel}" />
                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="ledfunction" Width="150" Content="Flags" Tag="Effects" Click="Function_Click" IsChecked="{Binding LedFunction, Converter={StaticResource StrEq}, ConverterParameter=flags}" />
                </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <TabControl x:Name="LedTabs" Style="{StaticResource ShiftlineTabControl}">
            <TabItem Header="RPM" IsEnabled="{Binding LedFunction, Converter={StaticResource FnTab}, ConverterParameter=rpm}" Style="{StaticResource ShiftlineTabItem}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <StackPanel>
                                <local:IconTitle IconKey="RevBar" Text="Rev bar style" />
                                <TextBlock Style="{StaticResource CardHint}" Text="How the rev bar fills as the engine speeds up. Every tile plays its pattern with your colours. SimHub setting fills left to right on the shift points you set for each car in SimHub (Cars settings)." />
                                <StackPanel Margin="0,14,0,0">
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="rpmstyle" IsChecked="{Binding RpmStyle, Converter={StaticResource StrEq}, ConverterParameter=middle}">
                                        <StackPanel>
                                            <local:LedPreview Kind="rpm" Pattern="middle" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Outside to centre" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="rpmstyle" IsChecked="{Binding RpmStyle, Converter={StaticResource StrEq}, ConverterParameter=leftRight}">
                                        <StackPanel>
                                            <local:LedPreview Kind="rpm" Pattern="leftRight" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Left to right" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="rpmstyle" IsChecked="{Binding RpmStyle, Converter={StaticResource StrEq}, ConverterParameter=simhub}">
                                        <StackPanel>
                                            <local:LedPreview Kind="rpm" Pattern="leftRight" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="SimHub setting" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource TestPlayButton}" Tag="RPM sweep" Click="TestEffect_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Show this on the LEDs for 3 seconds" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <local:IconTitle IconKey="ThemeStudio" Text="Colours" />
                            <TextBlock Style="{StaticResource CardHint}" Text="Pick a colour theme. Create and edit themes in the Theme Studio." />
                            <StackPanel Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <local:GradientBar Theme="{Binding SelectedItem, ElementName=RpmThemeList}" Width="180" Height="22" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardHint}" FontSize="11" Margin="0" Text="COLOUR THEME" />
                                    <TextBlock Style="{StaticResource CardTitle}" FontSize="14" Text="{Binding SelectedItem.Name, ElementName=RpmThemeList}" />
                                </StackPanel>
                                <ToggleButton x:Name="RpmThemeChange" Grid.Column="2" Style="{StaticResource GlassToggleButton}" Content="Change theme" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="RpmThemeList" Style="{StaticResource ThemeTileList}" Margin="0,14,0,0" ItemsSource="{Binding Themes}" SelectedValuePath="Id" SelectedValue="{Binding RpmThemeId, Mode=TwoWay}" Visibility="{Binding IsChecked, ElementName=RpmThemeChange, Converter={StaticResource BoolVis}}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Colour mode" />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource TileRadio}" GroupName="rpmmode" IsChecked="{Binding RpmColourMode, Converter={StaticResource StrEq}, ConverterParameter=blocks}">
                                    <StackPanel>
                                        <local:LedPreview Kind="rpm" Pattern="leftRight" ModeOverride="blocks" LedCount="14" Still="True" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                        <TextBlock Text="Blocks (solid zones)" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource TileRadio}" GroupName="rpmmode" IsChecked="{Binding RpmColourMode, Converter={StaticResource StrEq}, ConverterParameter=gradient}">
                                    <StackPanel>
                                        <local:LedPreview Kind="rpm" Pattern="leftRight" ModeOverride="gradient" LedCount="14" Still="True" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                        <TextBlock Text="Gradient (smooth blend)" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <local:IconTitle IconKey="LedPanel" Text="RPM thresholds" />
                            <TextBlock Style="{StaticResource CardHint}" Text="Where on the rev range the first and the last LED light up, as a share of the car's redline. Not used by the SimHub setting style." />
                            <StackPanel Margin="0,14,0,0">
                            <local:SlSlider Title="First LED at (% of redline)" Minimum="0" Maximum="100" Value="{Binding RpmStartPercent, Mode=TwoWay}" IsEnabled="{Binding RpmStyle, Converter={StaticResource StrNotEq}, ConverterParameter=simhub}" Margin="0,4" />
                            <local:SlSlider Title="Last LED at (% of redline)" Minimum="50" Maximum="120" Value="{Binding RpmEndPercent, Mode=TwoWay}" IsEnabled="{Binding RpmStyle, Converter={StaticResource StrNotEq}, ConverterParameter=simhub}" Margin="0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <StackPanel>
                                <local:IconTitle IconKey="Alert" Text="Redline behaviour" />
                                <TextBlock Style="{StaticResource CardHint}" Text="What happens when the engine reaches the redline." />
                                <StackPanel Margin="0,14,0,0">
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="redline" IsChecked="{Binding RpmRedline, Converter={StaticResource StrEq}, ConverterParameter=flash}">
                                        <StackPanel>
                                            <local:LedPreview Kind="redline" Pattern="flash" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Flash all LEDs" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="redline" IsChecked="{Binding RpmRedline, Converter={StaticResource StrEq}, ConverterParameter=flashAlt}">
                                        <StackPanel>
                                            <local:LedPreview Kind="redline" Pattern="flashAlt" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Alternate LEDs" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
    <RadioButton Style="{StaticResource TileRadio}" GroupName="redline" IsChecked="{Binding RpmRedline, Converter={StaticResource StrEq}, ConverterParameter=flashSwap}">
                                        <StackPanel>
                                            <local:LedPreview Kind="redline" Pattern="flashSwap" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Alternate colours" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="redline" IsChecked="{Binding RpmRedline, Converter={StaticResource StrEq}, ConverterParameter=off}">
                                        <StackPanel>
                                            <local:LedPreview Kind="redline" Pattern="off" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Nothing special" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <local:ColourPickerButton Colour="{Binding RpmFlashColour, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Flash colour" Margin="12,0,24,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    <local:ColourPickerButton Colour="{Binding RpmFlashColour2, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Second colour (for Alternate LEDs and Alternate colours)" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding RpmShiftFlash, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Also at SimHub's shift point (per car and gear)" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardHint}" Margin="104,2,0,0" FontSize="11" Text="The redline behaviour then also plays when SimHub says it is time to shift (Car settings in SimHub), not only at the car's redline." />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding RpmNoFlashInTopGear, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="No redline behaviour in the highest gear" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardHint}" Margin="104,2,0,0" FontSize="11" Text="Nothing to shift into there, so the bar just stays full." />
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource TestPlayButton}" Tag="Redline reached (rev limiter)" Click="TestEffect_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Show this on the LEDs for 3 seconds" />
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,2,0,12" Content="Reset this tab" Tag="RPM" Click="ResetTab_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Brake" IsEnabled="{Binding LedFunction, Converter={StaticResource FnTab}, ConverterParameter=brake}" Style="{StaticResource ShiftlineTabItem}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <StackPanel>
                                <local:IconTitle IconKey="Brake" Text="Brake bar" />
                                <TextBlock Style="{StaticResource CardHint}" Text="Where the brake bar is shown and how it fills. The top row is available with the function Brake pressure only." />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Where" Margin="0,14,0,6" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="brakearea" Content="Both sides" IsChecked="{Binding BrakeArea, Converter={StaticResource StrEq}, ConverterParameter=both}" />
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="brakearea" Content="Left side" IsChecked="{Binding BrakeArea, Converter={StaticResource StrEq}, ConverterParameter=left}" />
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="brakearea" Content="Right side" IsChecked="{Binding BrakeArea, Converter={StaticResource StrEq}, ConverterParameter=right}" />
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="brakearea" IsEnabled="{Binding BrakeTopAllowed}" Content="Top" IsChecked="{Binding BrakeArea, Converter={StaticResource StrEq}, ConverterParameter=top}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="How it fills" Margin="0,14,0,6" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="brakedir" IsChecked="{Binding BrakeDirection, Converter={StaticResource StrEq}, ConverterParameter=outIn}">
                                        <StackPanel>
                                            <local:LedPreview Kind="brake" Pattern="outIn" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Out to In" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="brakedir" IsEnabled="{Binding BrakeOnTop}" IsChecked="{Binding BrakeDirection, Converter={StaticResource StrEq}, ConverterParameter=leftRight}">
                                        <StackPanel>
                                            <local:LedPreview Kind="brake" Pattern="leftRight" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Left to Right" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="brakedir" IsEnabled="{Binding BrakeOnTop}" IsChecked="{Binding BrakeDirection, Converter={StaticResource StrEq}, ConverterParameter=rightLeft}">
                                        <StackPanel>
                                            <local:LedPreview Kind="brake" Pattern="rightLeft" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="Right to Left" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource TileRadio}" GroupName="brakedir" IsChecked="{Binding BrakeDirection, Converter={StaticResource StrEq}, ConverterParameter=inOut}">
                                        <StackPanel>
                                            <local:LedPreview Kind="brake" Pattern="inOut" LedCount="14" Animate="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, TargetNullValue=False, FallbackValue=False}" HorizontalAlignment="Center" Margin="0,0,0,9" />
                                            <TextBlock Text="In to Out" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                            </StackPanel>
                            <Button Style="{StaticResource TestPlayButton}" Tag="Brake pedal sweep" Click="TestEffect_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Show this on the LEDs for 3 seconds" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <local:IconTitle IconKey="ThemeStudio" Text="Colours and blinking" />
                            <StackPanel Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <local:ColourPickerButton Colour="{Binding BrakeColour, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Text="Brake colour" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding BrakeSmooth, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Text="Smooth fill" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                            <local:SlSlider Title="Blink from (% brake)" Minimum="0" Maximum="100" Value="{Binding BrakeBlinkStage1, Mode=TwoWay}" Margin="0,4" />
                            <local:SlSlider Title="Blink faster from (% brake)" Minimum="0" Maximum="100" Value="{Binding BrakeBlinkStage2, Mode=TwoWay}" Margin="0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,2,0,12" Content="Reset this tab" Tag="Brake" Click="ResetTab_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Pedals" IsEnabled="{Binding LedFunction, Converter={StaticResource FnTab}, ConverterParameter=pedals}" Style="{StaticResource ShiftlineTabItem}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <local:IconTitle IconKey="Pedals" Text="Pedal input presets" />
                            <TextBlock Style="{StaticResource CardHint}" Text="Shows what your feet do, not the engine: the position of the brake, throttle and clutch pedals as the game reports them. Pick a preset, or choose Custom and give every pedal its own area below. Changing an area below switches to Custom by itself." />
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="pedalpreset" Content="Brake left, throttle right" Tag="split" IsChecked="{Binding PedalPreset, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=split}" Click="PedalPreset_Click" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="pedalpreset" Content="Brake sides, throttle top" Tag="sidesTop" IsChecked="{Binding PedalPreset, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=sidesTop}" Click="PedalPreset_Click" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="pedalpreset" Content="Throttle only" Tag="throttle" IsChecked="{Binding PedalPreset, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=throttle}" Click="PedalPreset_Click" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="pedalpreset" Content="Brake only" Tag="brake" IsChecked="{Binding PedalPreset, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=brake}" Click="PedalPreset_Click" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="pedalpreset" Content="Clutch left, brake right, throttle top" Tag="three" IsChecked="{Binding PedalPreset, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=three}" Click="PedalPreset_Click" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="pedalpreset" Content="Custom" Tag="custom" IsChecked="{Binding PedalPreset, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=custom}" Click="PedalPreset_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <StackPanel>
                                <local:IconTitle IconKey="Pedals" Text="Area and colour of every pedal" />
                                <TextBlock Style="{StaticResource CardHint}" Text="When pedals share LEDs, the brake is drawn over the throttle and the throttle over the clutch. Side LEDs fill from the outermost LED inwards." />
                                <StackPanel Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding PedalsSmooth, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Smooth fill" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Brake" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    <ComboBox Grid.Column="1" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding PedalBrake, Mode=TwoWay}">
                                        <ComboBoxItem Tag="off" Content="Off" />
                                        <ComboBoxItem Tag="centreMiddle" Content="Top: from the middle outwards" />
                                        <ComboBoxItem Tag="centreLeft" Content="Top: left to right" />
                                        <ComboBoxItem Tag="centreRight" Content="Top: right to left" />
                                        <ComboBoxItem Tag="halfLeft" Content="Top: from the middle to the left" />
                                        <ComboBoxItem Tag="halfRight" Content="Top: from the middle to the right" />
                                        <ComboBoxItem Tag="centreEnds" Content="Top: from both ends inwards" />
                                        <ComboBoxItem Tag="sideLeft" Content="Left side LEDs" />
                                        <ComboBoxItem Tag="sideRight" Content="Right side LEDs" />
                                        <ComboBoxItem Tag="sideBoth" Content="Both side LEDs" />
                                    </ComboBox>
                                    <local:ColourPickerButton Grid.Column="2" Colour="{Binding BrakeColour, Mode=TwoWay}" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Throttle" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    <ComboBox Grid.Column="1" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding PedalThrottle, Mode=TwoWay}">
                                        <ComboBoxItem Tag="off" Content="Off" />
                                        <ComboBoxItem Tag="centreMiddle" Content="Top: from the middle outwards" />
                                        <ComboBoxItem Tag="centreLeft" Content="Top: left to right" />
                                        <ComboBoxItem Tag="centreRight" Content="Top: right to left" />
                                        <ComboBoxItem Tag="halfLeft" Content="Top: from the middle to the left" />
                                        <ComboBoxItem Tag="halfRight" Content="Top: from the middle to the right" />
                                        <ComboBoxItem Tag="centreEnds" Content="Top: from both ends inwards" />
                                        <ComboBoxItem Tag="sideLeft" Content="Left side LEDs" />
                                        <ComboBoxItem Tag="sideRight" Content="Right side LEDs" />
                                        <ComboBoxItem Tag="sideBoth" Content="Both side LEDs" />
                                    </ComboBox>
                                    <local:ColourPickerButton Grid.Column="2" Colour="{Binding ThrottleColour, Mode=TwoWay}" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Clutch" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    <ComboBox Grid.Column="1" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding PedalClutch, Mode=TwoWay}">
                                        <ComboBoxItem Tag="off" Content="Off" />
                                        <ComboBoxItem Tag="centreMiddle" Content="Top: from the middle outwards" />
                                        <ComboBoxItem Tag="centreLeft" Content="Top: left to right" />
                                        <ComboBoxItem Tag="centreRight" Content="Top: right to left" />
                                        <ComboBoxItem Tag="halfLeft" Content="Top: from the middle to the left" />
                                        <ComboBoxItem Tag="halfRight" Content="Top: from the middle to the right" />
                                        <ComboBoxItem Tag="centreEnds" Content="Top: from both ends inwards" />
                                        <ComboBoxItem Tag="sideLeft" Content="Left side LEDs" />
                                        <ComboBoxItem Tag="sideRight" Content="Right side LEDs" />
