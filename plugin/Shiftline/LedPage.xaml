                                    <local:SlSlider Title="Number of LEDs" Minimum="1" Maximum="8" Value="{Binding FxDrsCount, Mode=TwoWay}" Margin="0,4" />
                                </StackPanel>
                                <local:LedPreview Kind="layout" EffectName="Drs" Animate="False" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding FxDrsCustom, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EffectCard}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding FxDrsDetectOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" FontSize="14" Text="DRS detection point" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource TestPlayButton}" Tag="DRS detection point (iRacing)" Click="TestEffect_Click" IsEnabled="{Binding FxDrsDetectOn}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Show this effect on the LEDs for 3 seconds" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:ColourPickerButton Colour="{Binding FxDrsDetectColour, Mode=TwoWay}" ToolTip="Detection colour" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource EffectCard}">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding FxScDeltaOn, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" FontSize="14" Text="Safety car delta" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource TestPlayButton}" Tag="Safety car delta: too slow (F1)" Click="TestEffect_Click" IsEnabled="{Binding FxScDeltaOn}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Show this effect on the LEDs for 3 seconds" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:ColourPickerButton Colour="{Binding FxScDeltaOkColour, Mode=TwoWay}" ToolTip="On the delta" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <local:ColourPickerButton Colour="{Binding FxScDeltaOffColour, Mode=TwoWay}" ToolTip="Off the delta" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding FxScDeltaSwap, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Text="Swap the direction" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,2,0,12" Content="Reset this tab" Tag="Effects" Click="ResetTab_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Brightness" Style="{StaticResource ShiftlineTabItem}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <StackPanel>
                                <local:IconTitle IconKey="Sun" Text="Brightness" />
                                <TextBlock Style="{StaticResource CardHint}" Text="The LEDs of your device can be very bright. These values scale all colours. SimHub's own profile brightness applies on top of them." />
                                <StackPanel Margin="0,14,0,0">
                                <local:SlSlider Title="General brightness (%)" Minimum="1" Maximum="100" Value="{Binding BrightnessGeneral, Mode=TwoWay}" Margin="0,4" />
                                <local:SlSlider Title="Idle animation brightness (%)" Minimum="1" Maximum="100" Value="{Binding BrightnessIdle, Mode=TwoWay}" Margin="0,4" />
                                <TextBlock Style="{StaticResource CardHint}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" Text="{Binding NightModeNote}"
                                           Visibility="{Binding NightMode, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource TestPlayButton}" Tag="All LEDs on|Idle (configured style)" Click="TestEffect_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Show this on the LEDs for 3 seconds" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <local:IconTitle IconKey="Moon" Text="Night mode" />
                            <TextBlock Style="{StaticResource CardHint}" Text="One switch for driving in the dark: it halves the general and the idle brightness together. Switch it here or with a button (SimHub: Controls and events, action ToggleNightMode of Shiftline). The games do not tell reliably whether the headlights are on, so it is switched by hand." />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding NightMode, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Text="Night mode" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,2,0,12" Content="Reset this tab" Tag="Brightness" Click="ResetTab_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Idle" Style="{StaticResource ShiftlineTabItem}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <local:IconTitle IconKey="Idle" Text="Idle animation" />
                                <TextBlock Style="{StaticResource CardHint}" Text="Plays on the LEDs while no game is running and while the car is off in the garage or the menu. Off keeps them dark." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SegmentToggle}" IsChecked="{Binding IdleEnabled, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <StackPanel>
                                <local:IconTitle IconKey="Sparkles" Text="Style and speed" />
                                <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Style" />
                                <ComboBox Width="340" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding IdleStyle, Mode=TwoWay}">
                                    <ComboBoxItem Tag="sweep" Content="Sweep" />
                                    <ComboBoxItem Tag="wave" Content="Wave" />
                                    <ComboBoxItem Tag="comet" Content="Comet" />
                                    <ComboBoxItem Tag="fillDrain" Content="Fill and drain" />
                                    <ComboBoxItem Tag="centreOut" Content="Centre out" />
                                    <ComboBoxItem Tag="solid" Content="Solid" />
                                    <ComboBoxItem Tag="colourFade" Content="Colour fade" />
                                    <ComboBoxItem Tag="breathe" Content="Breathe" />
                                    <ComboBoxItem Tag="bounce" Content="Bounce" />
                                    <ComboBoxItem Tag="orbit" Content="Orbit" />
                                    <ComboBoxItem Tag="theatreChase" Content="Theatre chase" />
                                    <ComboBoxItem Tag="alternate" Content="Alternate" />
                                    <ComboBoxItem Tag="wipe" Content="Wipe" />
                                    <ComboBoxItem Tag="rain" Content="Rain" />
                                    <ComboBoxItem Tag="ripple" Content="Ripple" />
                                    <ComboBoxItem Tag="twinkle" Content="Twinkle" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Speed" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="idlespeed" Content="Slow" IsChecked="{Binding IdleSpeed, Converter={StaticResource StrEq}, ConverterParameter=slow}" />
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="idlespeed" Content="Normal" IsChecked="{Binding IdleSpeed, Converter={StaticResource StrEq}, ConverterParameter=normal}" />
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="idlespeed" Content="Fast" IsChecked="{Binding IdleSpeed, Converter={StaticResource StrEq}, ConverterParameter=fast}" />
                                </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource TestPlayButton}" Tag="Idle (configured style)" Click="TestEffect_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Show this on the LEDs for 3 seconds" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <local:IconTitle IconKey="ThemeStudio" Text="Colours" />
                            <TextBlock Style="{StaticResource CardHint}" Text="Pick a colour theme. Create and edit themes in the Theme Studio." />
                            <StackPanel Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <local:GradientBar Theme="{Binding SelectedItem, ElementName=IdleThemeList}" Width="180" Height="22" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardHint}" FontSize="11" Margin="0" Text="COLOUR THEME" />
                                    <TextBlock Style="{StaticResource CardTitle}" FontSize="14" Text="{Binding SelectedItem.Name, ElementName=IdleThemeList}" />
                                </StackPanel>
                                <ToggleButton x:Name="IdleThemeChange" Grid.Column="2" Style="{StaticResource GlassToggleButton}" Content="Change theme" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="IdleThemeList" Style="{StaticResource ThemeTileList}" Margin="0,14,0,0" ItemsSource="{Binding Themes}" SelectedValuePath="Id" SelectedValue="{Binding IdleThemeId, Mode=TwoWay}" Visibility="{Binding IsChecked, ElementName=IdleThemeChange, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,2,0,12" Content="Reset this tab" Tag="Idle" Click="ResetTab_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Fuel" Style="{StaticResource ShiftlineTabItem}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <local:IconTitle IconKey="Fuel" Text="Show fuel level on" />
                            <TextBlock Style="{StaticResource CardHint}" Text="The fuel level has the lowest priority: it only shows while nothing else uses that area, and it disappears completely as soon as the brake bar, a flag or an effect lights an LED there. Areas that the chosen LED function already uses are greyed out. Choose one side to keep the other side free for other information." />
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="fuelplace" Content="Off" IsChecked="{Binding FuelPlacement, Converter={StaticResource StrEq}, ConverterParameter=off}" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="fuelplace" Content="Top" IsEnabled="{Binding FuelCentreAllowed}" IsChecked="{Binding FuelPlacement, Converter={StaticResource StrEq}, ConverterParameter=centre}" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="fuelplace" Content="Both sides" IsEnabled="{Binding FuelSidesAllowed}" IsChecked="{Binding FuelPlacement, Converter={StaticResource StrEq}, ConverterParameter=sides}" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="fuelplace" Content="Left side" IsEnabled="{Binding FuelLeftAllowed}" IsChecked="{Binding FuelPlacement, Converter={StaticResource StrEq}, ConverterParameter=left}" />
                                <RadioButton Style="{StaticResource TileRadioDot}" GroupName="fuelplace" Content="Right side" IsEnabled="{Binding FuelRightAllowed}" IsChecked="{Binding FuelPlacement, Converter={StaticResource StrEq}, ConverterParameter=right}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource CardHint}" Margin="0,10,0,0" Text="Fuel moves out of the way while the brake bar is showing on the same side." Visibility="{Binding FuelYieldsToBrake, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <StackPanel>
                                <local:IconTitle IconKey="ThemeStudio" Text="Fuel colours" />
                                <TextBlock Style="{StaticResource CardHint}" Text="Used by the fuel gauge on the top row (function Fuel gauge) and by the fuel level on the chosen LEDs. The first colour of the theme is empty, the last one is full." />
                                <StackPanel Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <local:GradientBar Theme="{Binding SelectedItem, ElementName=FuelThemeList}" Width="180" Height="22" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardHint}" FontSize="11" Margin="0" Text="COLOUR THEME" />
                                        <TextBlock Style="{StaticResource CardTitle}" FontSize="14" Text="{Binding SelectedItem.Name, ElementName=FuelThemeList}" />
                                    </StackPanel>
                                    <ToggleButton x:Name="FuelThemeChange" Grid.Column="2" Style="{StaticResource GlassToggleButton}" Content="Change theme" VerticalAlignment="Center" />
                                </Grid>
                                <ListBox x:Name="FuelThemeList" Style="{StaticResource ThemeTileList}" Margin="0,14,0,0" ItemsSource="{Binding Themes}" SelectedValuePath="Id" SelectedValue="{Binding FuelThemeId, Mode=TwoWay}" Visibility="{Binding IsChecked, ElementName=FuelThemeChange, Converter={StaticResource BoolVis}}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Colour mode" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="fuelmode" Content="Blocks (solid zones)" IsChecked="{Binding FuelColourMode, Converter={StaticResource StrEq}, ConverterParameter=blocks}" />
                                    <RadioButton Style="{StaticResource TileRadioDot}" GroupName="fuelmode" Content="Gradient (smooth blend)" IsChecked="{Binding FuelColourMode, Converter={StaticResource StrEq}, ConverterParameter=gradient}" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ToggleButton Style="{StaticResource SegmentToggleSmall}" IsChecked="{Binding FuelSmooth, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="Smooth fill" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource TestPlayButton}" Tag="Fuel sweep" Click="TestEffect_Click" IsEnabled="{Binding FuelPlacement, Converter={StaticResource StrNotEq}, ConverterParameter=off}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Show this on the LEDs for 3 seconds" />
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,2,0,12" Content="Reset this tab" Tag="Fuel" Click="ResetTab_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
