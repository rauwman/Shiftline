<UserControl x:Class="Shiftline.Plugin.ColourPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ToggleButton x:Name="Toggle" Cursor="Hand" ToolTip="Click to choose a colour" Focusable="False">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Border x:Name="Swatch" Width="40" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="5" BorderBrush="#40FFFFFF" BorderThickness="1" />
        </ToggleButton>
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="#FF22262E" BorderBrush="#FF4A5160" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel Width="236">
                    <!-- the colour field: saturation from left to right, brightness from top to bottom; drag the dot -->
                    <Border CornerRadius="6" ClipToBounds="True" Width="236" Height="130">
                        <Grid x:Name="FieldArea" Background="Transparent" Cursor="Cross"
                              MouseLeftButtonDown="Field_MouseDown" MouseMove="Field_MouseMove" MouseLeftButtonUp="Field_MouseUp">
                            <Rectangle x:Name="FieldHue" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="FieldMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <!-- the hue bar -->
                    <Border CornerRadius="7" ClipToBounds="True" Width="236" Height="14" Margin="0,10,0,0">
                        <Grid x:Name="HueArea" Cursor="Hand"
                              MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Hue_MouseUp">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="HueMarker" Width="4" Height="14" Fill="White" Stroke="#99000000" StrokeThickness="1" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <!-- quick colours -->
                    <WrapPanel x:Name="Palette" Margin="0,10,0,0" />
                    <!-- opacity: LEDs cannot be see-through, so it dims the colour towards black -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="Opacity_ValueChanged" ToolTip="Dims the colour; 100 % is the full colour" />
                        <TextBlock x:Name="OpacityText" Grid.Column="2" Text="100 %" Foreground="#CCFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <!-- the hex code: type or paste a colour -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Hex code" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="HexBox" Grid.Column="1" MaxLength="7" Padding="6,3" Background="#FF171A20" Foreground="White" CaretBrush="White" BorderBrush="#FF4A5160"
                                 ToolTip="Type a colour like #FF8C00 and press Enter" KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
