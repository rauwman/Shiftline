<Window x:Class="Shiftline.Plugin.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="14" CornerRadius="14" Background="#FF161C26" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel MinWidth="320" MaxWidth="440">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="NoButton" Style="{StaticResource GlassButton}" Click="No_Click" />
                <Button x:Name="YesButton" Style="{StaticResource GlassButton}" Margin="0" Click="Yes_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
