<UserControl x:Class="Shiftline.Plugin.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shiftline.Plugin">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT PRESET" Margin="0" />
                <TextBlock x:Name="CurrentName" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,2,0,0" />
                <TextBlock x:Name="CurrentGame" Style="{StaticResource CardHint}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Presets" Text="Presets" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource GlassButton}" Content="+ New preset" Click="NewPreset_Click" />
                    <Button Style="{StaticResource GlassButton}" Content="Import" Click="Import_Click" />
                    <Button Style="{StaticResource GlassButton}" Content="Open folder" Click="OpenFolder_Click" />
                </WrapPanel>
                <TextBlock Style="{StaticResource CardHint}" Text="A preset is a full set of settings. Assign it to a game and it is loaded when that game starts; the star marks the preset a game starts with. Everything you change is saved into the active preset." />
                <ItemsControl x:Name="PresetList" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EffectCard}" Width="Auto" Margin="0,0,0,8" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource GlassToggleButton}" IsChecked="{Binding Favourite, Mode=TwoWay}" Width="44" Height="36" Padding="0"
                                                  VerticalAlignment="Top" Margin="0,0,10,0" ToolTip="Favourite: this preset is loaded when its game starts">
                                        <Viewbox Width="18" Height="18">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" Fill="{StaticResource TextPrimary}" />
                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,10,0">
                                        <TextBox Style="{StaticResource GlassNameBox}" Text="{Binding Name, Mode=OneWay}" LostFocus="Name_LostFocus" KeyDown="Name_KeyDown" ToolTip="Click to rename, Enter to confirm" />
                                        <TextBlock Style="{StaticResource CardHint}" FontSize="11" Margin="2,4,0,0" Text="{Binding Badge}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Width="220" Height="36" VerticalAlignment="Top" Margin="0,0,10,0" ItemsSource="{x:Static local:GameOption.All}"
                                              SelectedValuePath="Key" SelectedValue="{Binding Game, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource GlassButton}" Height="36" Content="Use" Click="Use_Click" />
                                        <Button Style="{StaticResource GlassButton}" Height="36" Content="Duplicate" Click="Duplicate_Click" />
                                        <Button Style="{StaticResource GlassButton}" Height="36" Content="Export" Click="Export_Click" />
                                        <Button Style="{StaticResource GlassButton}" Height="36" Content="Delete" Click="Delete_Click" Margin="0" />
                                    </StackPanel>
                                                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Car" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0" />
                                        <ComboBox Width="320" Height="36" ItemsSource="{Binding CarOptions}" SelectedValuePath="Key" SelectedValue="{Binding Car, Mode=TwoWay}"
                                                  ToolTip="Only load this preset for this car. The list fills with the cars SimHub reports while you play.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
