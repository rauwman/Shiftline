<UserControl x:Class="Shiftline.Plugin.TrackMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shiftline.Plugin">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="TrackMap" Text="Track Map" />
                    <TextBlock Style="{StaticResource CardHint}" Text="The cars as numbered circles on a line or a ring, with you highlighted. Place it in edit mode on the General page; pull the right or bottom edge to change its size." />
                </StackPanel>
                <ToggleButton x:Name="ShowToggle" Grid.Column="1" Style="{StaticResource SegmentToggle}" VerticalAlignment="Top" Click="ShowToggle_Click" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Update rate" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextPrimary}" />
                    <ComboBox x:Name="RateCombo" Width="190" Height="34" SelectionChanged="RateCombo_SelectionChanged" />
                    <Button Style="{StaticResource GlassButton}" Margin="24,0,0,0" Content="Reset the design" Click="ResetDesign_Click"
                            ToolTip="Puts every design choice of the Track Map back to the default. Whether it is shown, its position and its update rate stay." />
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <local:IconTitle IconKey="Sparkles" Text="Preview" />
                        <TextBlock Style="{StaticResource CardHint}" Text="How the map looks with your choices, filled with invented data. When it is longer than this page, scroll sideways. Edit mode shows the same sample on screen while no session is running." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton x:Name="PreviewStill" Style="{StaticResource GlassToggleButton}" Content="Still" Margin="0,0,6,0" Click="PreviewMode_Click" />
                        <ToggleButton x:Name="PreviewDriving" Style="{StaticResource GlassToggleButton}" Content="Driving" Click="PreviewMode_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PreviewGameText" Style="{StaticResource CardHint}" Margin="0,10,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="LegendText" Style="{StaticResource CardHint}" Margin="0,4,0,0" />
                <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="620" Margin="0,12,0,0">
                    <Border x:Name="PreviewHost" Padding="12" CornerRadius="10" Background="#FF2A3240" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layout" Text="Map" />
                <TextBlock Style="{StaticResource CardHint}" Text="The shape of the map and which part of the lap it shows." />
                <StackPanel x:Name="MapPanel" Margin="0,12,0,0" />
                <Button Style="{StaticResource GlassButton}" Content="Reset the Map group" Tag="Map" Click="ResetGroup_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layout" Text="Cars" />
                <TextBlock Style="{StaticResource CardHint}" Text="Circle size, the number inside and which cars are shown." />
                <StackPanel x:Name="CarsPanel" Margin="0,12,0,0" />
                <Button Style="{StaticResource GlassButton}" Content="Reset the Cars group" Tag="Cars" Click="ResetGroup_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layout" Text="Line" />
                <TextBlock Style="{StaticResource CardHint}" Text="The line or ring the cars run on." />
                <StackPanel x:Name="LinePanel" Margin="0,12,0,0" />
                <Button Style="{StaticResource GlassButton}" Content="Reset the Line group" Tag="Line" Click="ResetGroup_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="ThemeStudio" Text="Look" />
                <TextBlock Style="{StaticResource CardHint}" Text="Background, font and boxes of the map." />
                <StackPanel x:Name="LookPanel" Margin="0,12,0,0" />
                <Button Style="{StaticResource GlassButton}" Content="Reset the look" Tag="Look" Click="ResetGroup_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
