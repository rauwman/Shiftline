<UserControl x:Class="Shiftline.Plugin.StandingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shiftline.Plugin">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layers" Text="Standings" />
                <TextBlock Style="{StaticResource CardHint}" Text="The standings overlay is being built, step by step. This first step only reads the whole field from iRacing and shows it here, so the data can be checked before any overlay window exists. Start an iRacing session and look at the two cards below." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="Layers" Text="Show overlay" />
                    <TextBlock Style="{StaticResource CardHint}" Text="Shows the standings above the game. This first version is a plain list (the leaders, and the cars around you when you are further back) to test the overlay window; the real design comes next. Place it in edit mode on the General page." />
                </StackPanel>
                <ToggleButton x:Name="ShowToggle" Grid.Column="1" Style="{StaticResource SegmentToggle}" VerticalAlignment="Top" Click="ShowToggle_Click" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="Zap" Text="Update rate" />
                    <TextBlock Style="{StaticResource CardHint}" Text="Affects how often the standings update. Positions change slowly, so a low rate is enough. Choose the global rate to follow the general setting." />
                </StackPanel>
                <ComboBox x:Name="RateCombo" Grid.Column="1" Width="170" Height="36" VerticalAlignment="Top" SelectionChanged="RateCombo_SelectionChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Activity" Text="Data check" />
                <TextBlock Style="{StaticResource CardHint}" Text="Where the data comes from and whether each source delivers. A source that says missing is not available in your session." />
                <TextBlock x:Name="SummaryText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="ListOrdered" Text="Live standings" />
                <TextBlock Style="{StaticResource CardHint}" Text="The field as the plugin reads it, ten times per second. The same values are published as the SimHub properties Shiftline.Standings.01.Name, Shiftline.Standings.01.Position and so on (30 rows)." />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <TextBlock x:Name="TableText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
