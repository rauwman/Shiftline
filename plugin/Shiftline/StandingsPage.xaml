<UserControl x:Class="Shiftline.Plugin.StandingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shiftline.Plugin">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layers" Text="Standings" />
                <TextBlock Style="{StaticResource CardHint}" Text="The standings overlay is being built, step by step. This first step only reads the whole field from iRacing and shows it here, so the data can be checked before any overlay window exists. Start an iRacing session and look at the two cards below." />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="Layers" Text="Show overlay" />
                    <TextBlock Style="{StaticResource CardHint}" Text="Shows the standings above the game. Place and size it in edit mode on the General page." />
                </StackPanel>
                <ToggleButton x:Name="ShowToggle" Grid.Column="1" Style="{StaticResource SegmentToggle}" VerticalAlignment="Top" Click="ShowToggle_Click" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <local:IconTitle IconKey="Sparkles" Text="Preview" />
                        <TextBlock Style="{StaticResource CardHint}" Text="How the overlay looks with your choices, filled with invented data. Click a column to change its look. Edit mode shows the same sample on screen while no session is running." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton x:Name="PreviewRace" Style="{StaticResource GlassToggleButton}" Content="Race" Margin="0,0,6,0" Click="PreviewMode_Click" />
                        <ToggleButton x:Name="PreviewPractice" Style="{StaticResource GlassToggleButton}" Content="Practice / Qualify" Click="PreviewMode_Click" />
                    </StackPanel>
                </Grid>
                <Border x:Name="PreviewHost" Margin="0,12,0,0" Padding="12" CornerRadius="10" Background="#FF2A3240" HorizontalAlignment="Left" />
                <TextBlock x:Name="ColumnOptionsTitle" Margin="0,16,0,0" Style="{StaticResource CardTitle}" Text="Column options" />
                <TextBlock x:Name="ColumnOptionsHint" Style="{StaticResource CardHint}" Text="Click a column in the preview to change how it looks." />
                <StackPanel x:Name="ColumnOptionsPanel" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layout" Text="Columns" />
                <TextBlock Style="{StaticResource CardHint}" Text="Choose what each row shows. Gap and interval come from iRacing's race timing; in practice and qualifying they compare best laps." />
                <WrapPanel x:Name="ColumnPanel" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="ListOrdered" Text="Rows" />
                    <TextBlock Style="{StaticResource CardHint}" Text="How many cars the overlay shows. When you are further back, the last rows show you and the cars right before and after you." />
                </StackPanel>
                <ComboBox x:Name="RowsCombo" Grid.Column="1" Width="170" Height="36" VerticalAlignment="Top" SelectionChanged="RowsCombo_SelectionChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="Layout" Text="Header line" />
                    <TextBlock Style="{StaticResource CardHint}" Text="A line above the rows with the session, your car, laps or time left, the track temperature and your incidents." />
                </StackPanel>
                <ToggleButton x:Name="HeaderToggle" Grid.Column="1" Style="{StaticResource SegmentToggle}" VerticalAlignment="Top" Click="HeaderToggle_Click" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="Zap" Text="Update rate" />
                    <TextBlock Style="{StaticResource CardHint}" Text="Affects how often the standings update. Positions change slowly, so a low rate is enough. Choose the global rate to follow the general setting." />
                </StackPanel>
                <ComboBox x:Name="RateCombo" Grid.Column="1" Width="170" Height="36" VerticalAlignment="Top" SelectionChanged="RateCombo_SelectionChanged" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Activity" Text="Data check" />
                <TextBlock Style="{StaticResource CardHint}" Text="Where the data comes from and whether each source delivers. A source that says missing is not available in your session." />
                <TextBlock x:Name="SummaryText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="ListOrdered" Text="Live standings" />
                <TextBlock Style="{StaticResource CardHint}" Text="The field as the plugin reads it, ten times per second. The same values are published as the SimHub properties Shiftline.Standings.01.Name, Shiftline.Standings.01.Position and so on (30 rows)." />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <TextBlock x:Name="TableText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
