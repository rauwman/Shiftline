<UserControl x:Class="Shiftline.Plugin.StandingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shiftline.Plugin">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="ListOrdered" Text="Standings" />
                    <TextBlock x:Name="PageHint" Style="{StaticResource CardHint}" Text="A table with the whole field above the game: positions, names, gaps, lap times and more, with the columns and the look you choose below. Place and size it in edit mode on the General page." />
                </StackPanel>
                <ToggleButton x:Name="ShowToggle" Grid.Column="1" Style="{StaticResource SegmentToggle}" VerticalAlignment="Top" Click="ShowToggle_Click" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Update rate" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextPrimary}" />
                    <ComboBox x:Name="RateCombo" Width="190" Height="34" SelectionChanged="RateCombo_SelectionChanged" />
                    <Button x:Name="ResetButton" Style="{StaticResource GlassButton}" Margin="24,0,0,0" Content="Reset the design" Click="ResetDesign_Click"
                            ToolTip="Puts every design choice of the standings back to the default: columns, rows, size, look, classes and animation. Whether the overlay is shown, its position and its update rate stay." />
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <local:IconTitle IconKey="Sparkles" Text="Preview" />
                        <TextBlock Style="{StaticResource CardHint}" Text="How the overlay looks with your choices, filled with invented data. Click a column to change its look. Edit mode shows the same sample on screen while no session is running." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton x:Name="PreviewRace" Style="{StaticResource GlassToggleButton}" Content="Race" Margin="0,0,6,0" Click="PreviewMode_Click" />
                        <ToggleButton x:Name="PreviewPractice" Style="{StaticResource GlassToggleButton}" Content="Practice / Qualify" Margin="0,0,6,0" Click="PreviewMode_Click" />
                        <ToggleButton x:Name="PreviewAnimation" Style="{StaticResource GlassToggleButton}" Content="Animation" Click="PreviewMode_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PreviewGameText" Style="{StaticResource CardHint}" Margin="0,10,0,0" Visibility="Collapsed" />
                <Border x:Name="PreviewHost" Margin="0,12,0,0" Padding="12" CornerRadius="10" Background="#FF2A3240" HorizontalAlignment="Left" />
                <TextBlock x:Name="ColumnOptionsTitle" Margin="0,16,0,0" Style="{StaticResource CardTitle}" Text="Column options" />
                <TextBlock x:Name="ColumnOptionsHint" Style="{StaticResource CardHint}" Text="Click a column in the preview to change how it looks." />
                <StackPanel x:Name="ColumnOptionsPanel" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <local:IconTitle IconKey="Layout" Text="Columns" />
                        <TextBlock x:Name="ColumnsHint" Style="{StaticResource CardHint}" Text="Choose what each row shows. Gap and interval come from iRacing's race timing; in practice and qualifying they compare best laps." />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GlassButton}" VerticalAlignment="Top" Content="Reset order" Click="ResetOrder_Click" />
                </Grid>
                <TextBlock Style="{StaticResource CardHint}" Margin="0,10,0,0" FontStyle="Italic" Text="Click a column to switch it on or off. Drag it to another place to change the order." />
                <WrapPanel x:Name="ColumnPanel" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layout" Text="Rows and size" />
                <TextBlock x:Name="SizeHint" Style="{StaticResource CardHint}" Text="How many cars the overlay shows and how large it is drawn. In edit mode you can also pull the bottom edge (rows) or the right edge (size). When you are further back, the last rows show you and the cars right before and after you." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="RowsLabel" Text="Rows" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextPrimary}" />
                    <ComboBox x:Name="RowsCombo" Width="140" Height="34" SelectionChanged="RowsCombo_SelectionChanged" />
                    <TextBlock x:Name="SizeLabel" Text="Size" VerticalAlignment="Center" Margin="28,0,12,0" Foreground="{StaticResource TextPrimary}" />
                    <ComboBox x:Name="ScaleCombo" Width="140" Height="34" SelectionChanged="ScaleCombo_SelectionChanged" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="ThemeStudio" Text="Look" />
                <TextBlock Style="{StaticResource CardHint}" Text="Background, spacing and font of the whole overlay." />
                <StackPanel x:Name="LookPanel" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Layers" Text="Classes" />
                <TextBlock x:Name="ClassesHint" Style="{StaticResource CardHint}" Text="What the overlay shows in multi-class races. In single-class races all choices look the same." />
                <StackPanel x:Name="ClassesPanel" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Sparkles" Text="Animation" />
                <TextBlock x:Name="AnimationHint" Style="{StaticResource CardHint}" Text="When a car gains or loses a place, its row slides to the new position. Choose Animation above the preview to see it." />
                <StackPanel x:Name="AnimationPanel" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="Layout" Text="Header line" />
                    <TextBlock Style="{StaticResource CardHint}" Text="A line above the rows. Choose what it shows." />
                    <StackPanel x:Name="HeaderPanel" Margin="0,12,0,0" />
                </StackPanel>
                <ToggleButton x:Name="HeaderToggle" Grid.Column="1" Style="{StaticResource SegmentToggle}" VerticalAlignment="Top" Click="HeaderToggle_Click" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <local:IconTitle IconKey="Layout" Text="Footer line" />
                    <TextBlock Style="{StaticResource CardHint}" Text="A line below the rows with your last lap, the live delta of the running lap to your best (green when faster), your best lap and the best lap of the session." />
                    <StackPanel x:Name="FooterPanel" Margin="0,12,0,0" />
                </StackPanel>
                <ToggleButton x:Name="FooterToggle" Grid.Column="1" Style="{StaticResource SegmentToggle}" VerticalAlignment="Top" Click="FooterToggle_Click" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="Activity" Text="Data check" />
                <TextBlock Style="{StaticResource CardHint}" Text="Where the data comes from and whether each source delivers. A source that says missing is not available in your session." />
                <TextBlock x:Name="SummaryText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
        </Border>
        <Border x:Name="LiveCard" Style="{StaticResource GlassCard}">
            <StackPanel>
                <local:IconTitle IconKey="ListOrdered" Text="Live standings" />
                <TextBlock Style="{StaticResource CardHint}" Text="The field as the plugin reads it, ten times per second. The same values are published as the SimHub properties Shiftline.Standings.01.Name, Shiftline.Standings.01.Position and so on (30 rows)." />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <TextBlock x:Name="TableText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
