<UserControl x:Class="Shiftline.Plugin.SlSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Shiftline.Plugin;component/ShiftlineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock x:Name="TitleText" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,2" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="Bar" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5"
                    ValueChanged="Bar_ValueChanged" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="Box" Style="{StaticResource SlValueBox}" LostFocus="Box_LostFocus" KeyDown="Box_KeyDown" />
                <RepeatButton Style="{StaticResource SlStepButton}" Content="+" Click="Plus_Click" />
                <RepeatButton Style="{StaticResource SlStepButton}" Content="&#8211;" Click="Minus_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
